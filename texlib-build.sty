% texlib-build.sty
% Unified TeXLib build-flag CLI. Loaded by every TeXLib class so that all
% documents respond to the same compile-time / source-level toggles.
%
% Compile-time (passed via lualatex \def\Show…{}\input{file.tex}):
%   \ShowSolutions  \ShowKey  \ShowKeyInline  \ShowRubric  \ShowDraft
%   \StudentMode    \InstructorMode
%
% Source-level (placed in the document preamble):
%   \solutions  \keys  \keysinline  \rubrics  \drafts  \studentmode
%   \instructormode
%
% Conditionals exposed to class authors and downstream documents:
%   \ifsolutions  \ifkey  \ifrubric  \ifdraft  \ifstudent  \ifinstructor
%   \ifTeXLibAccessible
%
% Accessibility note: \ifTeXLibAccessible is TRUE during an "accessible" build
% (Sublime "Build — Accessible" / --texlib-mode=accessible). The builder issues
% \DocumentMetadata{tagging=on,...} BEFORE \documentclass -- which is the ONLY
% place tagging can be switched on -- and additionally defines
% \TeXLibAccessibleMode so classes/packages can adapt their output (drop
% tagging-hostile constructs, add alt text / MathML intents). Because
% \DocumentMetadata precedes \documentclass, this flag can only be SET from the
% command line, never from a class option; the source-level \accessible below is
% a preamble convenience that toggles the in-document behaviour only (it cannot
% retroactively enable tagging).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texlib-build}[2026/08/25 v0.7.4 TeXLib unified build flags]

% Conditionals
\newif\ifsolutions
\newif\ifkey
% Inline-key layout: per-part {partsolution} blocks are drawn INTO the student's
% reserved answer space rather than replacing it, so the key page is
% geometrically identical to the student copy.  Opt-in, because it reverses the
% \stretch / \workbox suppressions below that every other solution build wants.
\newif\ifsolinline
\newif\ifrubric
\newif\ifdraft
\newif\ifstudent
\newif\ifinstructor
\newif\ifTeXLibAccessible

% Compile-time toggles
\ifdefined\ShowSolutions      \solutionstrue        \fi
% \ShowKeyInline is \ShowKey with a different layout, and it has to say so by
% DEFINING \ShowKey, not merely by raising \ifkey. The classes do not agree on
% which to test: quiz.cls reads \ifkey, but autoexam.cls reads \ifdefined\ShowKey
% (it drives \AutoExamSolMode, i.e. which copies the version loop emits) and so
% would see no key request at all -- an exam or review built inline came out with
% every solution missing, silently. Declared before the \ShowKey line below so
% that test and every downstream \ifdefined\ShowKey sees it; texlib-build is
% loaded by texlib-assessment before autoexam reaches its own check.
\ifdefined\ShowKeyInline      \def\ShowKey{}\solinlinetrue \fi
\ifdefined\ShowKey            \keytrue              \fi
% A rubric annotates a worked solution, so it implies one: a rubric-only build
% renders point apportionments and common-error notes floating against blank
% answer space, which is of no use to anyone.  \ShowRubric therefore raises
% \ifsolutions too, and the standalone "Rubric" build mode was retired.
\ifdefined\ShowRubric         \rubrictrue\solutionstrue \fi
\ifdefined\ShowDraft          \drafttrue            \fi
\ifdefined\StudentMode        \studenttrue          \fi
\ifdefined\InstructorMode     \instructortrue       \fi
\ifdefined\TeXLibAccessibleMode \TeXLibAccessibletrue \fi

% Source-level toggles
\newcommand{\solutions}{\solutionstrue}
\newcommand{\keys}{\keytrue}
\newcommand{\keysinline}{\keytrue\solinlinetrue}
\newcommand{\rubrics}{\rubrictrue}
\newcommand{\drafts}{\drafttrue}
\newcommand{\studentmode}{\studenttrue\instructorfalse}
\newcommand{\instructormode}{\instructortrue\studentfalse}
\newcommand{\accessible}{\TeXLibAccessibletrue}

% Header build-mode badge ------------------------------------------------------
% The centered header indicator that marks an answers/instructor build. The
% mechanism (italic, header-center slot) is shared; the WORDING is class-specific
% -- lecture notes say "Instructor Version", problem sets/quizzes say "Answer
% Key" -- so each class declares its label once via \SetTeXLibBuildBadge and the
% header places \TeXLibBuildBadge in the center slot. The label is itself flag-
% guarded, so the badge vanishes in a plain student build:
%
%   \SetTeXLibBuildBadge{\ifsolutions Instructor Version\fi}   % in the class
%   \SetTeXLibHeader{...}{\TeXLibBuildBadge}{...}               % center slot
\newcommand{\texlib@buildbadge}{}
\newcommand{\SetTeXLibBuildBadge}[1]{\renewcommand{\texlib@buildbadge}{#1}}
\newcommand{\TeXLibBuildBadge}{\textit{\texlib@buildbadge}}

% Draft watermark --------------------------------------------------------------
% \ifdraft was declared here from the start and read by NOTHING -- ten classes,
% zero branches -- while the README advertised a "Draft watermark" and the
% Sublime palette offered a Draft build that provably changed nothing. A mode
% that silently does nothing is worse than no mode, so it does something now.
%
% Drawn through the kernel's shipout/background hook rather than a watermark
% package, so this stays dependency-free: texlib-build is loaded very early
% (before a class has processed its own options) and pulling xcolor/graphicx in
% here could change how those options resolve. The hook is installed at
% \AtBeginDocument instead, by which point every TeXLib class has loaded both --
% and guarded, so a document that somehow has neither degrades to a warning
% rather than an undefined-control-sequence.
\ifdraft
	\AtBeginDocument{%
		\@ifundefined{rotatebox}{%
			\PackageWarning{texlib-build}{%
				Draft build requested but graphicx/xcolor are not loaded;
				no watermark drawn}%
		}{%
			\AddToHook{shipout/background}{%
				\put(0.5\paperwidth,-0.5\paperheight){%
					\makebox(0,0){%
						\rotatebox{45}{%
							\textcolor{black!12}{%
								\fontsize{5cm}{5cm}\selectfont\bfseries DRAFT}}}}%
			}%
		}%
	}
\fi

% Build-variant planning sidecar -----------------------------------------------
% The builder plans a multi-variant build (student / solutions / instructor,
% each optionally tagged) and needs two facts it cannot get by reading the .tex:
% WHICH variants this class distinguishes, and WHETHER this document actually
% carries solution or rubric content. The second is unscrapeable from source --
% problems arrive through \loadbank / \getproblem / \importproblem at
% coursemeta-relative paths, so the only component that knows what was really
% typeset is the engine. So the engine reports it, in a <jobname>.buildmeta
% sidecar, exactly like the .pubmeta / .vmap / .schedmeta sidecars the builder
% already consumes.
%
% The detection is EXACT, not approximate, and that is the whole point: a build
% that hides solutions still typesets them into a discarded \vbox
% (texlib-solutions.sty, didactic.cls, pset.cls), so the environment runs either
% way and \TeXLibNoteSolution fires in a plain student build too. That is what
% lets the builder plan the entire variant set from its FIRST compile rather
% than learning it one build late.
%
% Classes declare what they distinguish, once, near their build-flag setup:
%   \TeXLibDeclareVariants{student,solutions,instructor}
% A class that declares nothing (syllabus, schedule, report-card, bank) gets a
% single-PDF build, which is correct -- none of them branches on a solution flag
% in a way that would produce a different document.
\newif\ifTeXLib@feat@solutions
\newif\ifTeXLib@feat@rubric
\newif\ifTeXLib@feat@commonerrors
\newif\ifTeXLib@feat@partsolution
% \global because the noting sites sit inside environments (and inside the
% discard \vbox group), so a local assignment would be rolled back at \egroup
% and the sidecar would report a document with no solutions in it.
\newcommand{\TeXLibNoteSolution}{\global\TeXLib@feat@solutionstrue}
\newcommand{\TeXLibNoteRubric}{\global\TeXLib@feat@rubrictrue}
\newcommand{\TeXLibNoteCommonErrors}{\global\TeXLib@feat@commonerrorstrue}
% A {partsolution} is a solution, so it notes both: the inline-key variant needs
% the specific flag, and every other solution-bearing variant needs the general
% one.
\newcommand{\TeXLibNotePartSolution}{%
	\global\TeXLib@feat@partsolutiontrue \TeXLibNoteSolution}

\newcommand{\TeXLib@variants}{}
\newcommand{\TeXLibDeclareVariants}[1]{\renewcommand{\TeXLib@variants}{#1}}

% A document may override its class's declaration with the course-metadata key
%   \metasetup{build-variants = {student, instructor}}
% (or `none' for the base PDF alone) -- for the worksheet whose solutions copy
% nobody wants, or the one handout that needs a variant its class does not
% normally offer. Guarded on the getter existing rather than on the package,
% because texlib-build is loaded by classes that reach course-metadata at
% different points and this runs at \AtEndDocument, by which time either the
% key resolved or it never will.
% It is resolved by \edef into a macro BEFORE the write, never tested inline
% inside it: \GetBuildVariants is an expandable expl3 getter, so \ifx against
% \@empty would compare its MEANING (never equal) rather than its expansion,
% which is the thing we care about -- and an \edef cannot live inside \write's
% own expansion pass anyway. \ifcsname is expandable, so the whole thing
% collapses to nothing when course-metadata never loaded.
\newcommand{\TeXLib@bv}{}

\newwrite\TeXLib@bm@stream
\AtEndDocument{%
	\begingroup
	\edef\TeXLib@bv{\ifcsname GetBuildVariants\endcsname\GetBuildVariants\fi}%
	\ifx\TeXLib@bv\@empty \let\TeXLib@bv\TeXLib@variants \fi
	\immediate\openout\TeXLib@bm@stream=\jobname.buildmeta\relax
	\immediate\write\TeXLib@bm@stream{variants=\TeXLib@bv}%
	\immediate\write\TeXLib@bm@stream{%
		has-solutions=\ifTeXLib@feat@solutions 1\else 0\fi}%
	\immediate\write\TeXLib@bm@stream{%
		has-rubric=\ifTeXLib@feat@rubric 1\else 0\fi}%
	\immediate\write\TeXLib@bm@stream{%
		has-commonerrors=\ifTeXLib@feat@commonerrors 1\else 0\fi}%
	\immediate\write\TeXLib@bm@stream{%
		has-partsolution=\ifTeXLib@feat@partsolution 1\else 0\fi}%
	\immediate\closeout\TeXLib@bm@stream
	\endgroup
}

% Tag suspension around DISCARDED content --------------------------------------
% Gating a build mode off does not stop the hidden content being typeset -- the
% classes capture it into a throwaway \vbox and drop the box. tagpdf still walks
% that material and records its structure, so the phantom lands nested inside the
% surrounding paragraph: a <text-unit> inside a <text>, i.e. PDF/UA "P-Part" and
% "P-P" nesting violations for content that is not even on the page. Wrap every
% discard box in this pair. Lives here, not in texlib-solutions.sty, because
% didactic.cls gates inline worked lead-ins the same way and does NOT load that
% package -- texlib-build is the one build-mode package they all share (the exam
% path reaches it via texlib-assessment, always before texlib-solutions).
% Kernel expl3 hooks via \csname (no ExplSyntaxOn needed, so the @-names stay
% intact); no-ops in a normal build where the tagging layer is absent.
\ifdefined\TeXLibAccessibleMode
	\newcommand\texlib@acc@tagsuspend{\csname tag_suspend:n\endcsname{texlibhidden}}
	\newcommand\texlib@acc@tagresume{\csname tag_resume:n\endcsname{texlibhidden}}
\else
	\newcommand\texlib@acc@tagsuspend{}
	\newcommand\texlib@acc@tagresume{}
\fi

\endinput
