\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texlib-solutions}[2026/08/25 v0.7.2 TeXLib shared solution box,
	rubric overlay, and multiple-choice key frame]

% Shared solution / rubric / multiple-choice-key rendering for the exam-derived
% classes (autoexam, quiz), so both produce identical keys.  Loaded by each class
% AFTER texlib-problembank.sty, because it overrides that package's \@mcframe@*
% and \workbox defaults.  Provides:
%   * the green {solution} / {partsolution} boxes (shown when \ifsolutions),
%   * the grading-rubric overlay (\rubric, shown when \ifrubric) and {commonerrors},
%   * the side-by-side multiple-choice key frame (\@mcframe@* override) and the
%     left-shifted \choiceshook.
% \ifsolutions / \ifrubric come from texlib-build; xcolor/environ from
% texlib-corepkg / texlib-problembank.  No longer requires tcolorbox: the
% {solution} box moved to plain \colorbox/\parbox (see its own comment below
% for why) and nothing else here ever used it -- autoexam.cls/pset.cls/
% didactic.cls load tcolorbox themselves for their own unrelated boxes, but
% quiz.cls had no other source for it, so this package's own use was quiz's
% only path to tcolorbox; quiz.cls itself never calls a tcolorbox command
% directly, so dropping this require is safe.

% ===========================================================================
% Rubric-overlay machinery
% ===========================================================================
% \rubric{pts}{text} appends a rubric item to one of two accumulators depending
% on which environment is active (\@sol@rubric inside {solution}, \@partsol@rubric
% inside {partsolution}).  The accumulators hold \@rubricline tokens emitted into
% a right-side overlay box pinned to the "Solution." line via \hfill\llap.  The
% overlay's height/depth are left natural (a zero-declared version was tried
% first, but its real ink still extended below the "Solution." line -- just
% uncounted by TeX's own spacing -- so it visually collided with the solution's
% own first line whenever that line ran long enough to reach the same right-hand
% region; see \@emit@rubric@overlay).  The \if@in@* flags tell \rubric which one.

\newif\if@in@partsolution  \@in@partsolutionfalse
\newif\if@in@solution      \@in@solutionfalse

% ACCESSIBLE: when solutions are HIDDEN (non-key build) the {solution} /
% {partsolution} environments still typeset their body into a DISCARDED \vbox
% (\setbox\z@) so counters/labels inside a solution stay consistent.  The box is
% dropped, so no glyphs ship -- but under PDF tagging tagpdf still records the
% solution body's structure (its inline math becomes empty <Formula>s) and,
% because the discarded box opens while the surrounding question paragraph is
% still active, that structure nests INSIDE the stem's <text>: a "P contains P /
% P contains Part" PDF/UA Table-5 violation with no visible cause.  Suspend
% tagging around the discarded box so it emits no structure at all.
%
% \texlib@acc@tagsuspend / \texlib@acc@tagresume are defined in texlib-build.sty,
% which every consumer of this package loads first (via texlib-assessment).  They
% moved there because didactic.cls gates inline worked lead-ins into a discard box
% the same way and hits the identical violation, but does not load this package.

\newbox\@partsol@box
\newbox\@sol@box
\newbox\@sol@vtop
\gdef\@partsol@rubric{}
\gdef\@sol@rubric{}

\newlength{\rubricboxwidth}
\setlength{\rubricboxwidth}{4.5cm}

% \@rubricline{pts}{text} — one aligned rubric item: a [N pts] label in a fixed
% 1.4 cm makebox, then the description.
% \hangindent/\hangafter so a criterion that wraps keeps its continuation lines
% under the description instead of running back to the label column -- the same
% hanging shape the {commonerrors} list gets from its \leftmargin, which is what
% makes the two footer panels read as a pair rather than as two loose lists.
\newlength{\@rubriclabelwd}
\setlength{\@rubriclabelwd}{1.4cm}
\newcommand{\@rubricline}[2]{%
	\par\noindent
	\hangindent\@rubriclabelwd \hangafter1
	\makebox[\@rubriclabelwd][l]{%
		\textbf{\textcolor{teal!80!black}{%
			[#1\,\ifnum#1=1 pt\else pts\fi]}}}%
	#2\par\smallskip
}

% \@emit@rubric@overlay{accumulator} — right-side overlay box pinned to the
% "Solution." line via \hfill\llap (right edge at \textwidth).  Height/depth are
% left natural (NOT zeroed) so \par charges the line for the overlay's real
% vertical extent, pushing whatever comes next (the solution body) down far
% enough to clear it -- a zero-height version let the overlay's ink bleed into
% the solution's own first line whenever that line ran long. Trade-off: a short
% solution now gets pushed down by however tall the rubric box is, even when it
% wouldn't have collided -- accepted since this only affects instructor-facing
% rubric builds, and the alternative (reflowing the solution's own already-
% \box'd first lines around the overlay) needs a two-pass height measurement
% that isn't worth it here.
% Kept for {partsolution}, which emits it BENEATH its prose rather than beside
% the header; the argument is the accumulator to render.
\newcommand{\@emit@rubric@overlay}[1]{%
	\setlength{\fboxsep}{4pt}%
	\colorbox{teal!8}{%
		\begin{minipage}[t]{\dimexpr\rubricboxwidth-8pt\relax}%
			\raggedright\small\sffamily
			\vspace{2pt}%
			\textbf{\textcolor{teal!80!black}{Rubric:}}\\[0.25em]%
			#1%
		\end{minipage}%
	}%
}

% --- The grading footer: common errors (left) beside the rubric (right) -----
%
% Both panels sit BENEATH the worked solution, inside the same green box.
%
% They used to be elsewhere, and both placements were wrong. The rubric was an
% overlay \llap'd onto the "Solution." header line with natural height/depth, so
% \par charged that line for the whole box -- meaning a four-item rubric shoved
% the solution four lines down, whether or not the solution's own first line came
% anywhere near it. {commonerrors} meanwhile typeset itself inline wherever it
% appeared in the source, so it landed mid-solution or trailed off the bottom
% depending on where the author happened to put it.
%
% Now neither is positioned by the author: {commonerrors} only CAPTURES its body
% (see below), \rubric only accumulates, and the solution's end-code lays both
% out here, after the work they annotate. Nothing pushes the solution anywhere.
% The panels are styled as a matched pair -- same \fboxsep, tint depth,
% \small\sffamily, bold coloured heading -- teal for the rubric (what the work
% earns) against red for the errors (what it loses), so the two read as one
% object rather than two unrelated boxes.
%
% Widths come from \hsize, not \linewidth: this runs inside the solution's own
% \vbox, whose \hsize the environment sets while LaTeX's \linewidth goes on
% holding the wider enclosing value.
\newlength{\@sol@footgap}    \setlength{\@sol@footgap}{1em}
\newlength{\@sol@cerrwd}
\newlength{\@sol@rubwd}
% Rubric's share of the width when both panels are present. Rubric entries are
% fragments ("[5 pts] ratio-test limit reduced"), common-error entries are whole
% sentences, so the split is deliberately uneven.
\newcommand{\@sol@rubshare}{0.40}

\newcommand{\@rubric@panel}[1]{%
	\setlength{\fboxsep}{4pt}%
	\colorbox{teal!8}{%
		\begin{minipage}[t]{\dimexpr#1-8pt\relax}%
			\raggedright\small\sffamily
			\vspace{2pt}%
			\textbf{\textcolor{teal!80!black}{Rubric:}}\\[0.25em]%
			\@sol@rubric
		\end{minipage}%
	}%
}

% Item labels: \item[4] prints [-4 pts], the deduction that error costs, in the
% label column where the rubric prints what the step earns.  The magnitude is
% what the author writes and the minus is supplied here, so the two panels can
% never disagree about the sign.  \item[0] means "costs nothing" (a wasted-effort
% note rather than a penalty) and prints a muted [0 pts].  A bare \item still
% works and falls back to the old square bullet -- documents predating the
% deduction labels keep rendering unchanged.
%
% The fallback is detected by giving the list a \relax default label and
% comparing against it: LaTeX routes both \item and \item[x] through \makelabel,
% so this is the only way to tell them apart from inside.  A non-integer optional
% argument is not supported (the \ifnum below would choke) -- the label column is
% for a number of points, and prose belongs in the item body.
\newlength{\@cerrlabelwd}
\setlength{\@cerrlabelwd}{1.55cm}
\def\@cerr@nolabel{\relax}
\newcommand{\@cerr@makelabel}[1]{%
	\def\@cerr@tmp{#1}%
	\makebox[\@cerrlabelwd][l]{%
		\ifx\@cerr@tmp\@cerr@nolabel
			\textcolor{red!70!black}{\rule[0.15ex]{0.45em}{0.45em}}%
		\else
			\textbf{\ifnum#1=0
				\textcolor{black!45}{[0\,pts]}%
			\else
				\textcolor{red!70!black}{%
					[$-$#1\,\ifnum#1=1 pt\else pts\fi]}%
			\fi}%
		\fi
	}%
}

% Same shell as the rubric panel, and the same hanging shape: label column of a
% fixed width, body indented past it.  {list} rather than {itemize} so every
% dimension is pinned outright instead of inherited from whatever nesting depth
% the surrounding {questions}/{parts} list left behind.
\newcommand{\@cerr@panel}[1]{%
	\setlength{\fboxsep}{4pt}%
	\colorbox{red!6}{%
		\begin{minipage}[t]{\dimexpr#1-8pt\relax}%
			\raggedright\small\sffamily
			\vspace{2pt}%
			\textbf{\textcolor{red!70!black}{Common Errors:}}\\[0.25em]%
			\begin{list}{\relax}{%
				\setlength{\topsep}{0pt}%
				\setlength{\partopsep}{0pt}%
				\setlength{\parsep}{0pt}%
				\setlength{\itemsep}{\smallskipamount}%
				\setlength{\labelwidth}{\@cerrlabelwd}%
				\setlength{\labelsep}{0.45em}%
				\setlength{\leftmargin}{\dimexpr\@cerrlabelwd+0.45em\relax}%
				\setlength{\itemindent}{0pt}%
				\setlength{\listparindent}{0pt}%
				\let\makelabel\@cerr@makelabel
			}%
				\@sol@cerr
			\end{list}%
			\vspace{1pt}%
		\end{minipage}%
	}%
}

% Lay out whichever panels exist. A lone panel keeps to its own side (errors
% left, rubric right) rather than stretching: a full-width rubric of four short
% fragments reads as a table, and holding the edge makes a run of solutions
% easier to skim.
\newcommand{\@emit@sol@footer}{%
	\ifx\@sol@cerr\@empty
		\ifx\@sol@rubric\@empty
		\else
			\par\vspace{8pt}\noindent
			\setlength{\@sol@rubwd}{\@sol@rubshare\hsize}%
			\hfill\@rubric@panel{\@sol@rubwd}\par
		\fi
	\else
		\par\vspace{8pt}\noindent
		\ifx\@sol@rubric\@empty
			\setlength{\@sol@cerrwd}{\dimexpr\hsize-\@sol@rubshare\hsize-\@sol@footgap\relax}%
			\@cerr@panel{\@sol@cerrwd}\hfill\par
		\else
			\setlength{\@sol@rubwd}{\@sol@rubshare\hsize}%
			\setlength{\@sol@cerrwd}{\dimexpr\hsize-\@sol@rubwd-\@sol@footgap\relax}%
			\@cerr@panel{\@sol@cerrwd}%
			\hfill
			\@rubric@panel{\@sol@rubwd}%
			\par
		\fi
	\fi
}

% ===========================================================================
% {solution} / {partsolution}
% ===========================================================================
% {solution} — full-problem solution block: a green box with a bold "Solution."
% header and any \rubric items overlaid on the right, shown when \ifsolutions;
% the content is silently discarded otherwise.  The body is collected into
% \@sol@box first so \rubric{}{} calls can populate \@sol@rubric before the header
% is emitted.  The exam class defines a native \solution; \let-ing it to \relax
% lets \newenvironment redefine it (the engine emits {solution} only when the
% problem actually has a non-empty solution).
%
% Rendering is plain \colorbox+\parbox, NOT tcolorbox, despite looking similar:
% content that reaches a tcolorbox's interior via \unvbox (as this box's content
% does -- \@sol@box above must be pre-collected so \rubric{}{} can populate the
% overlay before the header renders) gets SyncTeX-orphaned. \unvbox splices
% nodes into the current list with no box-open record of its own; the only
% enclosing record left is the wrapper's OWN self-tag (this .sty file, not the
% bank), and SyncTeX's reverse search (`synctex edit`, what a PDF viewer's
% double-click resolves through) cannot recover the correctly-tagged nodes
% spliced inside -- confirmed generic, not specific to solution content (even
% the untagged "Solution." header text below is equally unreachable inside a
% tcolorbox). \box (a real nested box node, unlike \unvbox's splice) fixes this
% -- but ONLY up through tcolorbox's *standard* mode; its `enhanced` mode
% (needed for the borderline-west accent) does further internal box surgery
% that defeats reverse search regardless. Hence: plain \colorbox/\parbox below,
% \box\@sol@box (not \unvbox), and the left accent hand-drawn with \vrule
% (sized from \ht\@sol@box/\dp\@sol@box, read BEFORE \box empties the register)
% instead of tcolorbox's borderline west. Trade-off: \box is a single rigid
% unit, so this box can no longer break across a page boundary the way the old
% breakable tcolorbox could -- accepted because every solution shipped in this
% repo is a few lines of prose/math (surveyed 2026-07-04: none exceed ~7 lines,
% none use tikz/tabular/multi-part content, no historical overflow incident).
% Outer vertical separation placed above and below the green solution box.
% 10pt suits a full-width free-response box (breathing room between the problem
% and its boxed solution).  The side-by-side multiple-choice key (\@mcframe@mid)
% shrinks it to 0pt locally: there the box lives in a narrow right-hand column
% whose height competes with the answer-choices column, and the inter-problem
% separator rule already spaces MC problems -- the 10pt chrome only made the
% solution column outgrow the choices, pushing problems onto extra pages.
\newlength{\@sol@outervsep}
\setlength{\@sol@outervsep}{10pt}
\let\solution\relax
\let\endsolution\relax
\newenvironment{solution}{%
	\ifsolutions
		\par
		\gdef\@sol@rubric{}%
		\gdef\@sol@cerr{}%
		\@in@solutiontrue
		\setbox\@sol@box\vbox\bgroup
			\hsize\dimexpr\textwidth-12pt\relax
	\else
		\gdef\@sol@cerr{}%
		% ACCESSIBLE: close the stem's paragraph before opening the discard box.
		% The \ifsolutions branch above makes \par its very first action; this one
		% never did. So when a source writes \begin{solution} with no blank line
		% before it -- which the sample bank does, straight after \end{parts} --
		% the throwaway vbox opens while the paragraph is still live, and the
		% phantom lands nested inside the enclosing list instead of as a sibling.
		% Everything typeset afterwards then becomes a child of that list: the
		% next \question nests LI-in-LI and following stems become P-in-L.
		% Suspending tagging is not sufficient on its own -- the box also has to
		% START in vertical mode, which is what the render branch gets for free.
		%
		% Bisected: parts alone 0, solution alone 0, parts THEN solution 1, and
		% the real quad problem (which is exactly that pair) is the only bank
		% entry that corrupts what follows it.
		\ifdefined\TeXLibAccessibleMode\par\fi
		\texlib@acc@tagsuspend\setbox\z@\vbox\bgroup
	\fi
}{%
	\ifsolutions
			% Still inside \@sol@box's \vbox: every \rubric call and the
			% {commonerrors} capture have run by now, and emitting here (rather
			% than after \box\@sol@box below) is what puts the panels INSIDE the
			% green fill, whose height is measured from this box.
			\ifrubric \@emit@sol@footer \fi
		\egroup
		\@in@solutionfalse
		% Harvest the inverse-search target from the BODY-ONLY box, before the
		% vtop below mixes in the "Solution." header (whose glyphs carry this
		% .sty's tag and would poison the target). See texlib_synctex.lua and
		% SYNCTEX.md: content glyphs are attributed correctly, the boxes built
		% around them are not, and the viewer resolves clicks by container.
		\ifdefined\directlua
			\directlua{texlib_synctex_read_target(\number\@sol@box)}%
		\fi
		\par\vspace{\@sol@outervsep}%
		\setlength{\fboxsep}{6pt}%
		% Collect the "Solution." header (+ any \rubric overlay) and the pre-\box'd
		% body into ONE \vtop, whose reference point is the header baseline. Then
		% \dp\@sol@vtop is the EXACT distance from that baseline down to the body's
		% bottom, so the green fill / left accent size to the real rendered content.
		% The old formula reconstructed the header->body gap from \ht\strutbox + a
		% fixed pad; that held for the full-width free-response box but came up short
		% in the narrow side-by-side MC-key column (the body sat a full extra line
		% below where the formula assumed), leaving the last line outside the fill.
		\setbox\@sol@vtop\vtop{%
			\hsize\dimexpr\textwidth-12pt\relax
			\noindent\texlibsolheader%
			\ifrubric
				\ifx\@sol@rubric\@empty\else
					\@emit@rubric@overlay{\@sol@rubric}%
				\fi
			\fi
			\par\vskip2pt
			\box\@sol@box
			% The 6pt bottom pad lives INSIDE the box, not as rule overhang. The
			% fill used to be drawn 6pt past \dp\@sol@vtop, and that overhang is
			% what displaced the SyncTeX records for everything in the box --
			% measured at +6.2pt, which is why clicking a solution resolved to
			% nothing while clicking below the line worked. Same ink either way;
			% the difference is whether the rule extends beyond the box it fills.
			\vskip6pt
		}%
		% Stamp every container and rule in the finished box with the harvested
		% solution source, so a click anywhere in the green box -- padding,
		% header, fill -- resolves there instead of dying on a tag-0 wrapper.
		\ifdefined\directlua
			\directlua{texlib_synctex_stamp_box(\number\@sol@vtop)}%
		\fi
		% Full-bleed to the true text margins.  {solution} renders inside the
		% exam-class {questions} list body, whose left indent (\@totalleftmargin)
		% \noindent does NOT remove; without this the full-\textwidth box is shifted
		% right by that indent and overhangs the right margin.  Pulling back by
		% -\@totalleftmargin lands both edges on the text block, matching the
		% inter-problem separator rule (autoexam.cls:\autoexam@problem@sep) exactly.
		% In the MC-key minipage \@totalleftmargin is 0 (minipage zeroes it), so this
		% is a no-op there and the box keeps its narrow column.
		\noindent\hspace*{-\@totalleftmargin}%
			\parbox[t]{\dimexpr\textwidth-12pt\relax}{%
				\noindent
					% Green fill + left accent \smash\rlap'd BEHIND the content on this
					% one line (the \box\@sol@vtop below shares this baseline = the
					% header baseline). NOT a \colorbox, which orphans the content for
					% SyncTeX reverse search (free-response-solution-inverse-search /
					% mc-key-inverse-search); the \rlap inside the parbox keeps the
					% \box'd nodes reachable. +6pt pad each side, matching the old
					% \colorbox{}'s \fboxsep=6pt.
					% The fill spans EXACTLY \ht+\dp of the box it backs -- no
					% overhang. Load-bearing for inverse search, not cosmetics.
					% Mechanism (SYNCTEX.md at the repo root has the full story):
					% the records never move -- the viewer's parser GROWS each
					% hbox's "visible" box to contain its children, rules
					% included, and resolves a click through a smallest-then-
					% deepest container contest over those grown boxes. A rule
					% overhanging this box made the smashed wrapper the deepest
					% container for clicks on the solution text, and its nodes
					% answer with no usable source -- so the click resolved to
					% nothing (measured: the dead band's edge tracked the fill's
					% overhang exactly, 159.1pt vs 153.1pt flush). \smash /
					% zero-declared sizes cannot help; TeX's dimensions are not
					% what the parser measures. Do not reintroduce padding by
					% growing the rule; re-measure any change with sol_probe
					% (recreatable from SYNCTEX.md) rather than reasoning.
					\smash{\rlap{\hspace{-6pt}\textcolor{\texlibsoltint}{%
						\rule[-\dp\@sol@vtop]%
							{\dimexpr\textwidth\relax}%
							{\dimexpr\ht\@sol@vtop+\dp\@sol@vtop\relax}}}}%
					% Left accent, top/bottom flush with the green fill (the same 6pt
					% pad), reading as a full-height left border like pset/didactic's
					% tcolorbox borderline west. \smash'd so it adds no height/depth.
					% The accent KEEPS its 6pt overhang, and that is not an
					% oversight. Measured: fill-flush + accent-overhanging
					% resolves at the glyph centre (offset 0.0pt), while
					% fill-flush + accent-flush regresses to +6.2pt. The two
					% rules are not independent -- what SyncTeX records is
					% governed by the line's overall extent, not by each rule
					% separately -- so this pairing is empirical, and any change
					% to either rule must be re-measured with sol_probe.py
					% rather than reasoned about.
					\smash{\rlap{\hspace{-6pt}\textcolor{\texlibsolrulecolor}{%
						\vrule width 1.5pt
							height \dimexpr\ht\@sol@vtop+6pt\relax
							depth \dimexpr\dp\@sol@vtop+6pt\relax}}}%
				\box\@sol@vtop
			}%
		\vspace{\@sol@outervsep}%
	\else
		\egroup\texlib@acc@tagresume
	\fi
}

% {partsolution} — inline per-part solution placed directly after \ppart; green
% prose with a bold "Solution." inline header (no tcolorbox, which would break
% inside the exam-class 'parts' list), shown when \ifsolutions.
\newenvironment{partsolution}{%
	\ifsolutions
		\par\smallskip
		\gdef\@partsol@rubric{}%
		\@in@partsolutiontrue
		\setbox\@partsol@box\vbox\bgroup
			% \textwidth (not \linewidth): the unvboxed prose below lands at the
			% true left text margin, so a full-\textwidth measure reaches — and stops
			% at — the right margin, spanning the text block exactly like the
			% full-bleed {solution} box above (verified: no right-margin overhang).
			\hsize\textwidth
	\else
		% Same asymmetry as {solution} above: the render branch opens with
		% \par\smallskip, this one opened the discard box in whatever mode the
		% part's prose left behind.
		\ifdefined\TeXLibAccessibleMode\par\fi
		\texlib@acc@tagsuspend\setbox\z@\vbox\bgroup
	\fi
}{%
	\ifsolutions
		\egroup
		\@in@partsolutionfalse
		% Same container-stamping as {solution}: harvest from the body box and
		% stamp it BEFORE \unvbox splices its content into the page list (the
		% spliced nodes keep their stamped fields; after the splice there is no
		% register left to walk).
		\ifdefined\directlua
			\directlua{texlib_synctex_read_target(\number\@partsol@box)
				texlib_synctex_stamp_box(\number\@partsol@box)}%
		\fi
		\noindent\texlibsolheader%
		\par
		{\color{green!40!black}\unvbox\@partsol@box}%
		\normalcolor
		% Beneath the prose, right-aligned -- same reason as {solution}: as an
		% overlay on the header line it pushed the part's own text down by the
		% full height of the rubric box.
		\ifrubric
			\ifx\@partsol@rubric\@empty\else
				\par\vspace{6pt}\noindent
				\hfill\@emit@rubric@overlay{\@partsol@rubric}%
			\fi
		\fi
		\par\smallskip
	\else
		\egroup\texlib@acc@tagresume
	\fi
}

% \rubric{pts}{text} — one grading criterion, shown only when \ifrubric.  Appends
% an \@rubricline to whichever solution accumulator is active.  Resolves at
% execution time, so it works anywhere before first use.
\NewDocumentCommand{\rubric}{mm}{%
	\ifrubric
		\if@in@partsolution
			\expandafter\gdef\expandafter\@partsol@rubric\expandafter{%
				\@partsol@rubric\@rubricline{#1}{#2}}%
		\else
			\if@in@solution
				\expandafter\gdef\expandafter\@sol@rubric\expandafter{%
					\@sol@rubric\@rubricline{#1}{#2}}%
			\fi
		\fi
	\fi
}

% {commonerrors} — a block of common student errors (\item each), shown only in
% rubric builds and only ever as the left panel of the solution footer.
%
% It CAPTURES rather than typesets: \NewEnviron stashes the body in \BODY, which
% is copied to \@sol@cerr for \@emit@sol@footer to render once the solution's
% own material is complete.  Three things fall out of that:
%   - Placement stops depending on where in the source the block sits.  It used
%     to typeset inline at that point, so a block written mid-solution rendered
%     mid-solution.
%   - Nothing is typeset at all when \ifrubric is false, where the old version
%     still set the body into a discarded \vbox (and so could still choke on
%     fragile content it was never going to show).
%   - The width is chosen at render time, which is what lets the panel size
%     itself against the rubric beside it.
% Verbatim content remains unsupported -- \BODY, like the old discarded box,
% re-reads the body as ordinary tokens.
%
% Outside a {solution} (a bare block, or one inside {partsolution}) there is no
% footer to defer to, so it renders where it stands, in the same panel style.
\NewEnviron{commonerrors}{%
	\ifrubric
		\if@in@solution
			\global\let\@sol@cerr\BODY
		\else
			\par\smallskip\noindent
			\global\let\@sol@cerr\BODY
			\@cerr@panel{\hsize}%
			\global\let\@sol@cerr\@empty
			\par\smallskip
		\fi
	\fi
}

% \workbox{n} — proportional answer space (= \vspace{\stretch{n}}), but suppressed
% in a solution/key build so a key copy is not padded with blank space.  Overrides
% the always-on default from texlib-problembank.sty.
\RenewDocumentCommand{\workbox}{m}{%
	\ifsolutions\else
		\vspace{\stretch{#1}}%
	\fi
}

% \stretch{n} — bank problems reserve extra student answer space INSIDE a
% problem body (e.g. between \part 1a and 1b) with a bare \vspace{\stretch{n}},
% not \workbox -- \workbox only covers the space AFTER the whole problem (the
% engine emits one per \problem[pts][stretch]{...} retrieval), so authors reach
% for raw \stretch for anything finer-grained.  Unlike \workbox that bare call
% has no \ifsolutions guard of its own across every bank file that uses it, so
% override the primitive itself here: \stretch is LaTeX's highest-precedence
% ("fill") glue order, meaning in a solutions build it was winning ALL leftover
% page height over \raggedbottom's own (lower-precedence "fil") bottom filler --
% shoving the solution down to the page bottom instead of right below the
% problem. Collapsing it to 0pt under \ifsolutions fixes every such call
% without having to touch each bank file; student builds are unaffected.
\let\texlib@stretch\stretch
\renewcommand{\stretch}[1]{\ifsolutions \z@\else\texlib@stretch{#1}\fi}

% ===========================================================================
% Multiple-choice key frame (the {mcproblems} section)
% ===========================================================================
% The engine selects/orders the options and emits exam-class \choice /
% \CorrectChoice bracketed by the \@mcframe@* hooks; here we override them so the
% instructor key sets the solution BESIDE the choices ("option B": stem full
% width, choices left, solution right) and shift the choices left.

% Shift the choices list left.  The exam class indents choices by
% width("W.")+labelsep+2.5em (deliberately wide); narrow it to a tidy hang that
% still clears the "(A)" labels.
\renewcommand{\choiceshook}{%
	\setlength{\leftmargin}{2em}%
	\setlength{\labelwidth}{\dimexpr\leftmargin-\labelsep\relax}%
	% Solutions copy only: firm up the choice-list spacing a touch so the eight
	% side-by-side MC keys pack four to a page across every shuffled version.  The
	% blank copy keeps the exam class's default (looser) spacing untouched -- it is
	% what students see, and its \stretch answer gap already fills the page.
	\ifsolutions
		\setlength{\topsep}{2pt}%
		\setlength{\partopsep}{0pt}%
		\setlength{\itemsep}{2pt}%
		\setlength{\parsep}{0pt}%
	\fi
}

% Side-by-side applies to vertical {choices}.  An inline {oneparchoices} block
% (\if@mc@inline) is rendered STACKED instead — choices inline, then the answer
% line, then the solution full width below — since a one-line option list does
% not suit a narrow column.
% Side-by-side fires only for an instructor (\ifsolutions) build of a vertical
% {choices} block (not \if@mc@inline); a student build, or an inline
% {oneparchoices} block, renders STACKED (no minipages) so the answer line and
% the solution sit full width below the choices.
% Choices column is narrower than the solution column -- choices are short
% (single terms/expressions), while solutions are prose and need the room.
\newlength{\@mc@choicew}  \setlength{\@mc@choicew}{0.42\linewidth}
\newlength{\@mc@solw}     \setlength{\@mc@solw}{0.54\linewidth}
% MC-key layout: side-by-side (default -- choices | solution columns, compact so
% four keys pack to a page) vs STACKED (solution full-width below the choices).
% Both layouts inverse-search now. Side-by-side used to orphan the solution
% (mc-key-inverse-search): the minipage's boxes carried tag 0 / library tags,
% and the viewer resolves clicks by a container contest over boxes, so clicks
% on the correctly-attributed glyphs died on their wrappers. Container stamping
% in texlib_synctex.lua closed that (see SYNCTEX.md), and the integration suite
% asserts both layouts with hard checks. \TeXLibMCKeyStacked remains as a pure
% LAYOUT choice -- full-width solution below the choices vs the compact
% four-keys-per-page packing -- no longer a searchability workaround.
\newif\if@mc@keystacked  \@mc@keystackedfalse
\newcommand{\TeXLibMCKeyStacked}{\@mc@keystackedtrue}
\renewcommand{\@mcframe@begin}[1]{%
	\def\@mc@letter{#1}%
	\par
	\ifsolutions \if@mc@inline\else \if@mc@keystacked\else
		\noindent\begin{minipage}[t]{\@mc@choicew}%
		% \begin{choices} starts with glue (its topsep addvspace), not a box, so
		% \vtop (what [t] positioning is built on) can't find a first box to
		% align against and falls back to treating the WHOLE box as hanging
		% below the baseline -- adding roughly a \baselineskip of extra gap
		% here that the student build (no minipage, same list, but merged
		% against the stem's own \parskip via \addvspace) never has. A strut
		% gives \vtop a real first box to measure; the tuned remainder cancels
		% the gap between a generic strut's height and the actual first
		% choice line's, matching the student build pixel-for-pixel (verified
		% against the tests/scenarios/exam/standard fixture).
		\strut\vspace*{-\dimexpr\ht\strutbox+\dp\strutbox+1.9pt\relax}%
	\fi \fi \fi
}
% Gap inserted between the last choice and the student answer line.  Empty by
% default (a fixed \medskip is the only separation, as before); autoexam sets it
% to \vspace{\stretch{1}} so the blank "Answer" rule floats to the bottom of the
% page group -- the MC analogue of a free-response \workbox.  Only the blank
% student build honors it; solution/key builds keep the answer beside/below the
% choices unchanged.
\providecommand{\@mc@answergap}{}
% Key-build counterpart of \@mc@answergap (see autoexam.cls for why the two can't
% be the same glue).  Empty by default, so quiz -- which spreads neither build --
% is unaffected.
\providecommand{\@mc@keyanswergap}{}
% The boxed key letter, sized to match the width of the blank copy's answer rule
% so "Answer:" lands at the same x on both builds; grows past that for a
% multi-answer key ("A, B, C") rather than overflowing the frame.
%
% Content is flush LEFT in the box, not centred.  Centring puts ~1cm of space
% between colon and letter, which pdftotext then extracts as two separate lines --
% breaking every consumer that scrapes "Answer: X" as one line (test_engine_
% correctness.py's _ANSWER_RE, collate_keys.py).  Flush left keeps the letter one
% \fboxsep from the label, so the extracted line is intact and the box reads like
% the student's answer blank with the answer filled in.
\newlength{\@mc@answerrule}  \setlength{\@mc@answerrule}{2.4cm}
\newlength{\@mc@keyboxw}
\newcommand{\@mc@answerbox}{%
	\settowidth{\@mc@keyboxw}{\strut\@mc@letter}%
	\addtolength{\@mc@keyboxw}{\dimexpr2\fboxsep+2\fboxrule\relax}%
	\ifdim\@mc@keyboxw<\@mc@answerrule \setlength{\@mc@keyboxw}{\@mc@answerrule}\fi
	\framebox[\@mc@keyboxw][l]{\strut\@mc@letter}%
}
% Right-aligned answer line; the letter is filled in for the key.  \noindent
% leaves vertical mode before \hfill (which would otherwise error there).
% Side-by-side (vertical {choices}, \ifsolutions, not \if@mc@inline) defers
% printing the line until \@mcframe@end, once both minipages have closed --
% printed here it would only \hfill across the narrow choices column instead
% of the full \linewidth, landing well short of where the student build (and
% the inline/stacked solutions build, which never opens a minipage) puts it.
\renewcommand{\@mcframe@answer}{%
	\ifsolutions
		\if@mc@inline
			\par\nobreak\medskip
			\noindent\hfill\textbf{Answer:}~\@mc@answerbox
			\par
		\else
			\par
		\fi
	\else
		\par\nobreak\medskip\@mc@answergap
		\noindent\hfill\textbf{Answer:}~\rule{\@mc@answerrule}{0.4pt}%
		\par
	\fi
}
\renewcommand{\@mcframe@mid}{%
	\ifsolutions \if@mc@inline\else
		\if@mc@keystacked
			\par\smallskip% stacked: solution full-width below the choices (in the
			              % vertical list, so it inverse-searches to the bank)
		\else
			% Side-by-side: close the choices column, open the (narrow) solution
			% column. Drop the box's outer padding so the "Solution." header
			% top-aligns with choice A and the column doesn't outgrow the choices.
			\end{minipage}\hfill\begin{minipage}[t]{\@mc@solw}%
		\fi
		\setlength{\@sol@outervsep}{0pt}%
	\fi \fi
}
\renewcommand{\@mcframe@end}{%
	\ifsolutions \if@mc@inline\else
		\if@mc@keystacked\else\end{minipage}\fi% side-by-side: close the solution column
		% The key letter goes exactly where the blank copy puts its answer rule:
		% full width, flush right, at the FOOT of the problem's slot just above the
		% separator rule -- NOT at the foot of the (narrow) solution column, which
		% left it floating mid-problem while the leftover height pooled beneath.
		% \@mc@keyanswergap floats it down there, mirroring \@mc@answergap in
		% \@mcframe@answer, and the answer line that follows is what protects that
		% glue: emitted as the LAST item of the problem it would instead be the end
		% of the vertical list when the next \question runs \addvspace, whose
		% \removelastskip drops it (an infinite skip compares as its 0pt natural
		% size, so it always loses).  \nobreak keeps the letter on the same page as
		% its solution -- a breakpoint at glue needs a non-discardable item before
		% it, and a penalty is discardable, so this also blocks a break at the gap.
		\par\nobreak\@mc@keyanswergap
		\noindent\hfill\textbf{Answer:}~\@mc@answerbox
	\fi \fi
	\par
}

\endinput
