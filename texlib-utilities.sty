% basic-utilities.sty
% Common utilities for Math, Figures, and Automations
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texlib-utilities}[2026/08/31 v0.8.0 Basic Utilities]

% -- Dependencies --
% Core packages (expl3/xparse, math, tikz/pgfplots, hyperref, texlib-mathutils)
% are bundled in texlib-corepkg.sty.  basic-utilities adds the extras that
% only the heavier classes (didactic, pset, report-card) actually want.
\RequirePackage{texlib-corepkg}

% siunitx (+0.18s), caption (+0.20s) and tasks (+0.32s) are deferrable -- see
% \TeXLibDefer in texlib-corepkg.sty for the mechanism and the measurements.
% Each carries its own configuration INSIDE its loader, so a document that
% defers one never executes that configuration either: \sisetup without siunitx,
% or \settasks without tasks, is an undefined control sequence, and running them
% at load time would make the deferral fatal instead of free.
%
% enumitem is deliberately NOT deferrable and stays eager below. {parts} is
% \newlist'd from it at load time and is the base exercise idiom every heavy
% class inherits, and [shortlabels] changes what \begin{enumerate}[(a)] means
% library-wide -- a document deferring it would break in ways that read as the
% document's own fault. At +0.26s that is not a trade worth offering.
\TeXLibDefer{Units}{%
	\RequirePackage{siunitx}%
	\sisetup{table-number-alignment=center, mode=math}%
}

\TeXLibDefer{Caption}{\RequirePackage{caption}}

% tasks: grid layout for exercise parts, \begin{tasks}(N) \task ... \end{tasks}
% Defaults: bold lowercase letter + period, e.g. "a."
\TeXLibDefer{Tasks}{%
	\RequirePackage{tasks}%
	\settasks{
		label        = \textbf{\alph*.},
		label-align  = right,
		label-width  = 1.5em,
		item-indent  = 2.5em,
		column-sep   = 1em,
		after-item-skip = 6pt plus 2pt minus 2pt,
	}%
}

% -- TikZ Config: extend the core library set with the visualisation ones --
% Routed through \TeXLibAtTikz so this survives \TeXLibNoTikz: the libraries
% load now if tikz is already here, and otherwise ride along with a later
% \TeXLibLoadTikz.
\TeXLibAtTikz{\usetikzlibrary{datavisualization, fit, calc, backgrounds}}

% -- parts: dedicated env for vertical exercise parts (no shortlabel needed) --
% Usage:  \begin{parts} \item ... \item ... \end{parts}
% Renders bold a., b., c., ...   General \begin{enumerate} is unaffected.
\RequirePackage[shortlabels]{enumitem}
\newlist{parts}{enumerate}{4}
% leftmargin=* is enumitem's "derive the margin from the label width" sentinel,
% not a dimension. Under tagging the block-based lists read the value as a
% dimension and every \begin{parts} emits "Missing number"/"Illegal unit of
% measure" (three errors apiece) before recovering at 0pt. pset.cls already
% carries this fix for the {parts} it redefines; the base declaration here is
% what Notes and Report Cards get, and it was still handing them the sentinel.
% 2em is what * resolved to for a bold "a." label (labelwidth ~1.5em +
% labelsep 0.5em). The normal branch keeps *, so print output is unchanged.
\ifdefined\TeXLibAccessibleMode
	\setlist[parts]{
		label    = \textbf{\alph*.},
		labelsep = 0.5em,
		leftmargin = 2em,
		itemsep  = 2pt,
		topsep   = 4pt,
	}
\else
	\setlist[parts]{
		label    = \textbf{\alph*.},
		labelsep = 0.5em,
		leftmargin = *,
		itemsep  = 2pt,
		topsep   = 4pt,
	}
\fi

% =========================================================
% 1. MATH MACROS
% =========================================================
% Math macros (\mbb, \abs, \lrp, \lrb, \lrcb, \lrsb, \dd, \deriv, \inte,
% \todo, ...) now live in texlib-mathutils.sty, loaded above. The siunitx
% table/mode configuration that used to sit here moved into the \TeXLibDefer
% {Units} loader at the top of this file: it depends on siunitx, so it has to
% run if and only if siunitx is actually loaded.

% =========================================================
% 2. AUTOMATION HELPERS
% =========================================================
\ExplSyntaxOn

	\cs_new_protected:Nn \cn_auto_label:nn {
		\tl_set:Nn \l_tmpa_tl { #2 }
		\tl_set:Nx \l_tmpa_tl { \str_lowercase:f { \l_tmpa_tl } }
		\regex_replace_all:nnN { [^a-z0-9\ ] } { } \l_tmpa_tl
		\regex_replace_all:nnN { \s+ } { - } \l_tmpa_tl
		\regex_replace_all:nnN { ^-|-$ } { } \l_tmpa_tl
		\label{#1:\l_tmpa_tl}
	}
	\NewDocumentCommand{\AutoLabel}{ m m }{ \cn_auto_label:nn {#1} {#2} }

\ExplSyntaxOff

% -- Figure Wrapper --
% Directory prefix for \fig images. Override per document with
% \renewcommand{\figdir}{path/to/figs/} (keep the trailing slash).
\providecommand{\figdir}{Figures/}
% Accessibility (tagged-PDF first step): derive alt-text from the caption, or the
% file name when there is no caption, and pass it to \includegraphics's alt= key
% -- LaTeX's official image-accessibility hook.  It is inert until PDF tagging is
% enabled (\DocumentMetadata{...}); once it is, every \fig carries real alt text.
% Override per image with an explicit alt= in the options arg (it wins, being
% placed after this default).
\newcommand{\@fig@alt}[2]{\if\relax\detokenize{#1}\relax #2\else #1\fi}
\NewDocumentCommand{\fig}{ s O{} O{} m }{%
	\begin{figure}[!ht]
	\IfBooleanTF{#1}{\raggedleft}{\centering}
	\if\relax\detokenize{#3}\relax
		\includegraphics[width=0.5\textwidth,height=0.35\textwidth,keepaspectratio,alt={\@fig@alt{#2}{#4}}]{\figdir #4}
	\else
		\includegraphics[alt={\@fig@alt{#2}{#4}},#3]{\figdir #4}
	\fi
	\if\relax\detokenize{#2}\relax
		\AutoLabel{fig}{#4}
	\else
		\caption{#2}
		\AutoLabel{fig}{#2}
	\fi
	\end{figure}%
}