# Sublime workspace + project state (per-machine)
*.sublime-workspace
*.sublime-project

# Old / superseded files
course-metadata_old.sty

# Local per-machine working notes; not distributed to coworkers
/CLAUDE.md

# Local feature-idea scratch log (cron-appended; not distributed to coworkers)
/FEATURE-IDEAS.md

# Generated accessibility feature gallery (a11y_gallery.py output; multi-MB,
# environment-specific renders — regenerate locally, don't commit)
/a11y_gallery.html
# Generated gallery: ~9 MB of base64-embedded page renders, rebuilt from
# the manifest on demand. Never committed.
/class_gallery.html
# veraPDF's per-document conformance report, written beside the tagged PDF on
# every accessible build. The PDF it describes is already ignored below, so
# without this an accessible build leaves one tracked file behind and a
# `git add -A` commits it -- which is how one reached a PR.
*_accessible-report.html

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.synctex.gz.sum.synctex
*.synctex
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.dvi
*.pdf
# biblatex/biber and the TeXLib variant sidecar. These were missing, and a
# command-line build in a module directory (which does not route aux out of the
# tree the way the Sublime builder does) leaves all three behind -- they were
# caught on their way into a commit, not by the ignore list.
*.bcf
*.run.xml
*.buildmeta

# TeXLib schedule class scaffolding (now written to the aux dir, but a
# stale copy may linger from a command-line build that bypassed the
# Sublime builder).
*.schedmap
*_schedule_grid.tex
# Resolved-entry sidecar (schedule.lua writes it every build; sync_calendar.py
# consumes it) and that tool's per-course id map. The state file holds Google
# event/task ids for a personal account -- never commit it to a public repo.
*.schedmeta
.calendar-sync-state.json

# Publish sidecar (course-metadata.sty writes it for a publishable class; the
# Sublime builder consumes it, but a CLI build that bypassed the builder leaves
# it) and the package_for_lms.py bundle.
*.pubmeta
# Resolved-metadata dump (course-metadata.sty writes <base>.metadump every build;
# the Sublime "Show Resolved Metadata" reads it -- a debug/inspection sidecar).
*.metadump
# Bank-preview wrapper + PDF generated by "TeXLib: Bank Preview" next to a bank.
*-catalog.tex
*-catalog.pdf
*_LMS.zip

# autoexam / SyncTeX build scratch (generated next to the source by a
# command-line build that bypassed the Sublime builder's cleanup).
*.key
*.sco
*_autoexam_body_*.tex
*.srcmap
*_synctex.tex
*_synctex_*.tex
_footer_check.png

# Python build artifacts
__pycache__/
*.pyc

# smoke_test.py failure logs + local scratch
.smoke_logs/
/dump.txt
# Underscore-prefixed scratch dirs (_scratch, _custtest, _psettest, ...) are
# local experiments that must never reach the public repo.
_*/
# Retired per-machine Sublime user folder (kept on disk, not tracked).
SublimeUser/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*~
.#*

# CI-run metadata written by visual.yml's update_refs dispatch into the
# artifact; never commit state (see the workflow comment).
tests/visual_refs/.regen-manifest
