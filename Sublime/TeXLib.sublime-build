{
	// TeXLib.sublime-build -- build system for the TeXLib library.
	//
	// Deploy to Packages/User/. Then in Sublime: Tools > Build System > TeXLib.
	//   Ctrl+B         -- default: the base PDF plus every variant this
	//                     document actually supports, each with a tagged twin
	//   Ctrl+Shift+B   -- pick one: Base only, Solutions, Instructor, ...
	// The "TeXLib: Build ..." entries in the command palette do the same.
	//
	// Each variant passes --texlib-mode=<mode> through LaTeXTools' documented
	// `options` channel; texlib_builder.py pops that token out of self.options
	// and injects the matching TeXLib flag (\def\ShowKey{}, \def\StudentMode{},
	// ...). The remaining options, if any, go to the engine unchanged.

	// LaTeXTools' build target. The "Unable to find target command:
	// latextools_make_pdf" warning sometimes shown in the console at
	// startup is a false alarm -- Sublime validates .sublime-build files
	// before all plugins finish loading, but the command IS registered by
	// the time a build actually runs.
	"target": "latextools_make_pdf",
	"cancel": {"kill": true},
	"selector": "text.tex.latex",
	"builder": "texlib",

	"windows": {
		"file_regex": "^((?:.:)?[^:\\n\\r]*):([0-9]+):?([0-9]+)?:? (.*)$"
	},
	"linux": {
		"file_regex": "^(...*?):([0-9]+): ([0-9]*)([^\\.]+)"
	},
	"osx": {
		"file_regex": "^(...*?):([0-9]+): ([0-9]*)([^\\.]+)"
	},

	"variants": [
		{
			// The plain build alone -- what Ctrl+B did before the variant
			// fan-out. Fully settled, unlike Quick.
			"name": "Base only (one PDF)",
			"builder": "texlib",
			"options": ["--texlib-mode=base"]
		},
		{
			// The STUDENT-facing key: answers, no grading apparatus. This is
			// what "Answer Key" used to be called; the mode names are the
			// audience now, not the mechanism.
			"name": "Solutions (student key)",
			"builder": "texlib",
			"options": ["--texlib-mode=solutions"]
		},
		{
			// Same answers, laid into the student's reserved blank so the key
			// page's geometry matches the student copy. Needs {partsolution}.
			"name": "Solutions (in the answer space)",
			"builder": "texlib",
			"options": ["--texlib-mode=solutions-inline"]
		},
		{
			// Instructor build: worked solutions AND the grading rubric.
			// There is deliberately no rubric-only variant -- a rubric
			// annotates a solution, so rubric-without-solutions is never
			// what you want. \ShowRubric implies \ifsolutions anyway.
			"name": "Instructor (solutions + rubric)",
			"builder": "texlib",
			"options": ["--texlib-mode=instructor"]
		},
		{
			"name": "Student Copy",
			"builder": "texlib",
			"options": ["--texlib-mode=student"]
		},
		{
			"name": "Draft",
			"builder": "texlib",
			"options": ["--texlib-mode=draft"]
		},
		{
			"name": "Quick (single pass, refs may be stale)",
			"builder": "texlib",
			"options": ["--texlib-mode=quick"]
		},
		{
			// Default without the content check: builds the answer variants
			// even when the document reports no solutions. The escape hatch
			// for when you don't believe the detection.
			"name": "Full (every variant, no pruning)",
			"builder": "texlib",
			"options": ["--texlib-mode=full"]
		},
		{
			// Paired build: the normal PDF (the class's own engine, unchanged)
			// AND a tagged, screen-reader-friendly PDF/UA twin as
			// <base>_accessible.pdf. The tagged half is forced to lualatex and
			// injects \DocumentMetadata{tagging=on,...} ahead of
			// \documentclass. Syllabus/schedule publish their TAGGED half to
			// the shareable LMS names.
			"name": "Accessible (normal + tagged PDF/UA pair)",
			"builder": "texlib",
			"options": ["--texlib-mode=accessible"]
		}
	]
}
