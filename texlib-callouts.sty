% texlib-callouts.sty
% Always-visible "callout" environments shared by the boxed teaching classes
% (didactic, pset): {hint} and {readings}. Both are build-mode independent (no
% \ifsolutions guard). Extracted from pset.cls during the consolidation pass so
% the two classes share ONE implementation instead of drifting copies; didactic
% gains both for parity with pset.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texlib-callouts}[2026/08/25 v0.7.4 TeXLib shared callout environments]

\RequirePackage{texlib-theorems}   % texlibbase + \texlibrulewidth + tcolorbox (\NewTColorBox)
\RequirePackage{enumitem}          % keyval itemize for {readings}

% \hint -- a run-in "Hint." lead-in, always visible (no \ifsolutions guard).
%
% Replaces the former {hint} tcolorbox. A COMMAND matches how \solution, \answer
% and \pf are already used inside the problem-shaped environments -- you write
% the hint as ordinary following prose instead of wrapping it in \begin/\end --
% and it drops a tcolorbox, which is a bonus for the tagged PDF/UA build (the
% tcolorbox inner list is what breaks under tagging=on).
%
%     \hint Differentiate both sides with respect to $t$.
%
% BREAKING: \begin{hint}...\end{hint} no longer exists. Convert call sites to the
% command form.
\newcommand{\hint}{\par\medskip\noindent\textbf{Hint.}\space}

% {readings} -- a bold "Readings." header + indented en-dash list, no box. Use to
% list assigned readings under a section/day. Lightweight: tight vertical spacing.
%
%   \begin{readings}
%       \item Stewart, Calculus, §2.1--2.2.
%       \item Course notes, Lecture 1.
%   \end{readings}
% Accessible build: the same keys, declared with \setlist on a dedicated list
% instead of inline. Under \DocumentMetadata{tagging=on} the new block
% implementation takes over \begin{itemize}'s optional argument and rejects
% enumitem's keys outright -- "Some keys specified on the itemize environment
% are unknown", fatal, and it fires on ANY key, not a particular one. That made
% every lecture containing a {readings} block produce no accessible PDF at all.
% Preamble \setlist declarations are still honoured, so the accessible branch
% routes the body through a \newlist-declared list configured there. The normal
% branch is untouched, so a normal build's output is unchanged.
\ifdefined\TeXLibAccessibleMode
	\newlist{texlibreadings}{itemize}{1}
	\setlist[texlibreadings]{leftmargin=2em, topsep=2pt, parsep=2pt,
							 itemsep=2pt, label={\textendash}}
	\newenvironment{readings}
		{%
			\par\addvspace{6pt}%
			\noindent{\bfseries Readings.}\par\nopagebreak
			\begin{texlibreadings}%
		}
		{%
			\end{texlibreadings}\addvspace{4pt}%
		}
\else
	\newenvironment{readings}
		{%
			\par\addvspace{6pt}%
			\noindent{\bfseries Readings.}\par\nopagebreak
			\begin{itemize}[leftmargin=2em, topsep=2pt, parsep=2pt,
							itemsep=2pt, label={\textendash}]%
		}
		{%
			\end{itemize}\addvspace{4pt}%
		}
\fi

\endinput
