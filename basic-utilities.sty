\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{basic-utilities}[2026/08/31 v0.8.0 basic-utilities wrapper over texlib-utilities (TeXLib)]
\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{texlib-utilities}}
\ProcessOptions\relax
\RequirePackage{texlib-utilities}
