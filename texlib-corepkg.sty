\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texlib-corepkg}[2026/08/31 v0.8.0 TeXLib core package bundle]

% ==============================================================================
% texlib-corepkg.sty — core package bundle for every TeXLib document class
% ==============================================================================
%
% Loads the LaTeX packages every TeXLib class needs anyway: font + geometry,
% LaTeX3 core, math (amsmath/amssymb/amsthm/mathtools), graphics
% (graphicx/xcolor/tikz/pgfplots), and hyperref + the canonical hypersetup
% used across the library.
%
% WHO ACTUALLY LOADS THIS. The list here used to say "lightweight classes --
% autoexam, quiz, schedule, bingo, syllabus -- load it directly", and three of
% those five do not load it at all. Checked by reading every class:
%
%   via basic-utilities     didactic, pset, report-card
%                           (which also adds siunitx/caption/tasks/enumitem)
%   via texlib-assessment   autoexam, quiz, bank
%   NOT AT ALL              schedule, bingo, syllabus -- they load neither this
%                           bundle nor basic-utilities
%   NOT AT ALL              texlib-thesis, deliberately: it loads no TeXLib
%                           package, so a thesis is not coupled to the teaching
%                           library (it takes \TeXLibDefer from texlib-defer.sty,
%                           which has no dependencies of its own)
%
% So a change here reaches six of the ten classes, not all of them. That is easy
% to get wrong from the old list and it has been got wrong.
%
% Class-specific packages (lastpage, needspace, tocloft, multicol, tcolorbox,
% adjustbox, comment, ...) stay in each class file; this bundle is only the
% true intersection of every class's needs.

% --- Font + geometry ---
% Font setup is engine-conditional, and it has to be: under a Unicode engine a
% T1-encoded 8-bit font silently corrupts text. LuaTeX has no UTF-8 -> LICR
% layer at all (\DeclareUnicodeCharacter is not even defined there), so a
% literal "§" in the source is never translated to \textsection. It is handed to
% ec-lmr10 as codepoint 0xA7, and T1 slot 0xA7 is `gbreve' -- the document
% typesets "ğ". The same accident hits every character whose codepoint lands in
% the T1 upper half: "¡" sets `aogonek', "¿" sets `ccaron', "ß" sets "SS", "×"
% sets an OE ligature. Characters above U+00FF have no 8-bit slot at all -- "Ł",
% "ř", the en dash, curly quotes -- and are dropped from the page outright,
% leaving only a "Missing character" line in the log.
%
% None of that is visible without reading the log or the PDF text layer, which
% is how it survived this long: on a 139-character non-ASCII probe, lualatex got
% 79 wrong (11 mis-set, 68 dropped) and pdflatex got 0 wrong. The accessible
% build forces lualatex for EVERY class, so this hit precisely the builds the
% accessibility program exists to protect. test_text_layer.py (repo root, run
% by smoke.yml) is the regression gate; it generates its own probe document and
% round-trips it through this bundle under both engines.
%
% Under pdfTeX the inputenc LICR layer does the translation and T1 is correct,
% so that path is unchanged.
%
% This is not a design change: Latin Modern is the same typeface either way --
% lmodern's Type1 EC fonts under pdfTeX, the OpenType originals under fontspec.
% lmodern is still loaded on both paths for the 8-bit math symbol fonts, and
% fontspec's [no-math] leaves that math setup alone, so math output is
% byte-identical and only the text faces change.
%
% texlib-thesis.cls does not route through this bundle; it already loads
% fontspec directly, for this same reason.
%
% The pdfTeX branch keeps fontenc BEFORE lmodern, which is the order this
% bundle has always used. That is not cosmetic: loading lmodern first changes
% which .fd is in play when the encoding is set, and it moves glyphs on the
% page -- it cost a visual-reference diff on notes__worked-gated (a pdflatex
% scenario that this fix must not touch at all) before the order was restored.
\RequirePackage{iftex}
\ifPDFTeX
	\RequirePackage[T1]{fontenc}
	\RequirePackage{lmodern}
\else
	\RequirePackage{lmodern}
	\RequirePackage[no-math]{fontspec}
	\setmainfont{Latin Modern Roman}
	\setsansfont{Latin Modern Sans}
	\setmonofont{Latin Modern Mono}
\fi
\RequirePackage[margin=1in]{geometry}

% --- LaTeX3 core ---
\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{ifthen}
\RequirePackage{etoolbox}

% ==============================================================================
% Deferrable components
% ==============================================================================
% Package loading is the dominant cost of a TeXLib build. On a 6-page notes
% document, class loading is ~3.5s of a ~5.5s engine pass and the document's own
% content is ~0.25s -- so what the bundle loads matters far more than anything
% the author writes. Measured marginal costs (lualatex, TeX Live 2026):
%
%     biblatex  +1.21s    tikz    +0.47s    enumitem  +0.26s
%     pgfplots  +0.88s    tasks   +0.32s    caption   +0.20s
%     hyperref  +0.49s                      siunitx   +0.18s
%
% \TeXLibDefer{<Name>}{<loader>} makes one component skippable. It always
% defines \TeXLibLoad<Name> (idempotent -- a second call is a no-op), and runs it
% immediately UNLESS \TeXLibNo<Name> was defined before \documentclass.
%
% The default is therefore unchanged: every component still loads, and no
% existing document is affected. What the macro adds is a way to say "this
% document does not use plots" and get the second back. The build tooling emits
% these flags automatically -- see texlib_preamble_scan.py, which reads a
% document (and its \input tree) and defers only what provably never appears --
% so in practice an author never writes one by hand.
%
% \TeXLibNo<Name> must be set BEFORE \documentclass, because the class loads
% this bundle. \TeXLibLoad<Name> can be called any time in the preamble, and
% must be: \RequirePackage is an error after \begin{document}, so a deferred
% component cannot be resurrected from the body.
%
% The macro itself lives in texlib-defer.sty, which has no dependencies of its
% own. It was inline here until texlib-thesis.cls needed it: that class
% deliberately loads no TeXLib package, and pulling this whole bundle in to
% reach one macro would have handed it lmodern, the wrong geometry, pgfplots and
% a different hypersetup -- slower, not faster. \TeXLibDeferOff (same mechanism,
% opposite default) lives there too.
\RequirePackage{texlib-defer}

% --- Color (load before tikz so tikz uses the right colour table) ---
\RequirePackage{xcolor}

% --- Math ---
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}

% --- TeXLib math macros (depends on the math packages above) ---
\RequirePackage{texlib-mathutils}

% --- Graphics + TikZ ---
% graphicx is cheap and universally needed; it stays eager.
\RequirePackage{graphicx}

% tikz (+0.47s) carries the three libraries every TeXLib diagram uses.
%
% \TeXLibNoTikz is honoured here and, for every class that loads this bundle,
% reclaims NOTHING -- because they all reach tcolorbox (directly, or through
% texlib-thmenv -> texlib-theorems) and tcolorbox loads tikz itself, after this
% deferral has skipped its own \RequirePackage. Probed with \@ifpackageloaded on
% a bare stub of each class: didactic, pset, report-card, quiz, autoexam, bank
% and bingo all end with tikz loaded whether the flag is set or not. An earlier
% comment here claimed ~0.1s was reclaimed on the boxed classes and the full
% 0.47s on "the unboxed classes (syllabus, schedule)"; both halves were wrong,
% the second because syllabus and schedule do not load this bundle at all.
%
% So the flag is kept for documents that opt out by hand, and
% texlib_preamble_scan.py deliberately does NOT set it for any class that loads
% this bundle. texlib-thesis is the one place deferring tikz works, and that
% class does its own \TeXLibDeferOff{Tikz} rather than coming through here.
\TeXLibDefer{Tikz}{%
	\RequirePackage{tikz}%
	\usetikzlibrary{arrows.meta, positioning, shapes.geometric}%
}

% pgfplots is the single most expensive package in this bundle (+0.88s on top of
% tikz) and only documents that actually draw \begin{axis} plots need it. It
% still loads by default (backward compatible: existing documents are
% unaffected). A plot-free document can OPT OUT -- reclaiming that time on every
% engine pass -- by putting
%     \def\TeXLibNoPlots{}
% BEFORE \documentclass. If such a document later does need a plot, call
% \TeXLibLoadPlots in its preamble to pull pgfplots in on demand.
%
% pgfplots \RequirePackage{tikz}es on its own, so a document that defers Tikz but
% keeps Plots still gets a working tikz -- minus the three libraries above, which
% is why \TeXLibLoadTikz is called here rather than left to chance.
\TeXLibDefer{Plots}{%
	\TeXLibLoadTikz
	\RequirePackage{pgfplots}%
	\pgfplotsset{compat=1.18}%
}

% \TeXLibAtTikz is defined in texlib-defer.sty alongside \TeXLibDefer.

% --- Hyperref + canonical setup ---
% Five of the existing TeXLib classes ship the exact same hypersetup call.
% Centralising it here means a single edit reaches every class.  Classes that
% want additional tikz libraries, extra link colours, or a different setup
% (rare) can load them AFTER \RequirePackage{texlib-corepkg}.
\RequirePackage{hyperref}
\hypersetup{
	colorlinks=true,
	urlcolor=blue,    % URLs stay blue (useful in syllabi, course sheets, etc.)
	linkcolor=black,  % internal cross-references: invisible in print, still clickable
	citecolor=black   % citations likewise
}

% ==============================================================================
% Shared solution-box appearance (C2)
% ==============================================================================
% ONE source for the solution box's colours + header, referenced by BOTH the
% exam/quiz shared box (texlib-solutions.sty) and pset's own box, so the solution
% look retunes in one place.  The two boxes deliberately keep DIFFERENT
% mechanisms: the shared box is \colorbox/\box/\vrule (a real nested box node) so
% SyncTeX reverse search survives -- tcolorbox's `enhanced` mode defeats it --
% while pset's is a tcolorbox because it needs the \StudentMode watermarked
% blank-answer box.  corepkg is loaded by every class, so both see these macros.
% (Full mechanism-level "one box" is blocked by that SyncTeX constraint.)
\providecommand{\texlibsoltint}{green!3!white}          % box fill
\providecommand{\texlibsolrulecolor}{green!50!black}     % left accent (shown)
\providecommand{\texlibsolblankrulecolor}{black!40}      % dashed rule (student blank)
\providecommand{\texlibsolheader}{\textbf{Solution.}}    % bold run-in header

\endinput
